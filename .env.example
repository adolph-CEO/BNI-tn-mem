# 伺服器埠號（本機執行時使用；Vercel 部署不需要）
PORT=3000

# PostgreSQL 連線字串（必填）。可使用 Neon / Vercel Postgres / Supabase / Railway 等
# 雲端 Postgres，或本機安裝的 PostgreSQL。範例（Neon）：
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# 本機 Postgres 若未啟用 SSL，請在連線字串加上 ?sslmode=disable
DATABASE_URL=

# 初始超級管理帳號（第一次啟動時若尚無任何 admin 帳號會自動建立）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# Session 簽章密鑰。正式環境（尤其是 Vercel）務必自行設定一組隨機字串，
# 否則每次冷啟動會產生新密鑰，導致所有人被登出。
# 可用指令產生： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
